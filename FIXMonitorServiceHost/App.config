    <add key="waitBeforeConnecting" value="5000" />
    <add key="isRunWithSampleData" value="false" />
    <add key="heartbeatIntervalForWeb" value="5000" />
    <add key="heartbeatIntervalForFixHub" value="5000" />
    <add key="fixHubServerPort" value="55555" />
    <!--<add key="fixHubServerIP" value="10.0.12.107" />-->
    <!--QA-->
    <add key="fixHubServerIP" value="10.0.10.132" /> 
    <add key="sendSampleFixUpdate" value="false" />
    <add key="loadEntriesCount" value="10000" />
    <add key="redisStreamName" value="FixMessages" />
    <add key="baseAddress" value="http://localhost:1005/FIXMonitorService" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <!-- Email Configurations -->
	  <add key="FromEmail" value="logiciel.subscriptions@logicielservice.com" />
	  <add key="FromPass" value="" />
	  <!--<add key="CommaSeperatedToEmails" value="notification@logicielservice.com" />-->
	  <add key="CommaSeperatedToEmails" value="" />
	  <add key="CommaSeperatedCCEmails" value="" />
	  <add key="EmailApiKey" value="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" />
	  <add key="Environment" value="QA" />
	  <add key="DefaultConnection" value="Server=.;Database=FIXMonitor;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=false;" />
	  <add key="FixMessageLogDirectoryPath" value="./FixMessagesLogs/" />
	  <add key="JenkinsUsername" value="web-oms-user" />
	  <add key="JenkinsPassword" value="Logicie!123" />
	  <add key="JenkinsCrumbUrl" value="http://35.222.65.105:8080/crumbIssuer/api/xml?xpath=concat(//crumbRequestField,&#34;:&#34;,//crumb)" />
	  <add key="JenkinsJobTriggerUrl" value="http://35.222.65.105:8080/job/OMSServers/job/FixHub-Config-Using-Web/job/Http-Trigger-For-FixHub-Config-Deployment/buildWithParameters" />
  </appSettings>
  <system.web>
    <compilation debug="true" />
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
