<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="HttpStreaming" maxReceivedMessageSize="67108864" transferMode="Streamed" />
      </basicHttpBinding>
      <netTcpBinding>
        <binding name="netTcp" receiveTimeout="01:05:00" maxBufferSize="67108864" maxReceivedMessageSize="67108864" maxBufferPoolSize="67108864" transferMode="Buffered" closeTimeout="01:00:10" openTimeout="01:00:10" sendTimeout="01:01:00">
          <security mode="None" />
        </binding>
      </netTcpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="mexBehavior">
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <services>
      <service behaviorConfiguration="mexBehavior" name="FIXMonitorService.FIXMonitorService">
        <endpoint address="FIXMonitorService" binding="netTcpBinding" bindingConfiguration="netTcp" contract="FIXMonitorService.IFIXMonitorService" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:1005/FIXMonitorService" />
            <add baseAddress="net.tcp://localhost:1006/FIXMonitorService" />
          </baseAddresses>
        </host>
      </service>
    </services>
  </system.serviceModel>
  <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
  <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
